{
  "experiments": {
    "token_pruning_core": {
      "description": "Core aggressive visual-token pruning claim, based on LLaVA-1.5-7B at 64 retained visual tokens from Table 1 and efficiency constraints from Table 7.",
      "weight": 1.0,
      "primary_metric": "performance_retained",
      "metrics": {
        "performance_retained": {
          "higher_is_better": true,
          "coefficient": 1.0
        },
        "evidence_retained": {
          "higher_is_better": true,
          "coefficient": 0.25,
          "description": "Mean query-evidence similarity retained by the compressed tokens; this catches methods that preserve global context while losing the local evidence needed for the answer."
        },
        "context_retained": {
          "higher_is_better": true,
          "coefficient": 0.4,
          "description": "Mean global-context similarity retained by the compressed tokens; this catches relevance-only shortcuts that keep salient evidence but drop low-saliency contextual information."
        },
        "mean_token_count": {
          "higher_is_better": false,
          "coefficient": -0.3
        },
        "retained_fraction": {
          "higher_is_better": false,
          "coefficient": -0.5
        },
        "sample_count": {
          "higher_is_better": true,
          "coefficient": 0.0
        }
      },
